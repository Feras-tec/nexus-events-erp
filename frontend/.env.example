# Auth-V2 is the default. Explicit temporary rollback: clerk on BOTH frontend and backend.
VITE_AUTH_MODE=auth-v2
# Only needed for the explicit Clerk rollback; never put a Clerk secret key here.
VITE_CLERK_PUBLISHABLE_KEY=
# Auth-V2 uses relative same-origin /api paths. Clerk rollback can set a backend URL.
VITE_API_URL=
# Local Vite proxy only; never use a production backend for local acceptance tests.
NEXUS_LOCAL_API_TARGET=http://127.0.0.1:3210
