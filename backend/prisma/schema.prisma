// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Zentrale Firma des ERP-Systems
model Company {
  id        String   @id @default(uuid())
  name      String
  legalName String?
  taxNumber String?
  vatId     String?
  email     String?
  phone     String?
  website   String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
}

// Niederlassung einer Firma, z. B. Hamburg oder Berlin
model Branch {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  city      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  departments Department[]
  warehouses  Warehouse[]
  employees   Employee[]

  @@index([companyId])
}

// Abteilung innerhalb einer Niederlassung
model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  employees Employee[]

  @@unique([branchId, name])
  @@index([branchId])
}

// Physisches Lager einer Niederlassung
model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  inventoryItems InventoryItem[]

  @@index([branchId])
}

// Status eines Mitarbeiters
enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
}

// Typ eines Mitarbeiterdokuments
enum EmployeeDocumentType {
  RESIDENCE_PERMIT
  WORK_PERMIT
  PASSPORT
  CONTRACT
  OTHER
}

// Mitarbeiter der Firma
model Employee {
  id          String         @id @default(uuid())
  employeeNo  String         @unique
  firstName   String
  lastName    String
  email       String?        @unique
  phone       String?
  birthDate   DateTime?
  nationality String?
  position    String?
  status      EmployeeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  employmentPeriods  EmploymentPeriod[]
  documents          EmployeeDocument[]
  equipmentMovements EquipmentMovement[]

  @@index([branchId])
  @@index([departmentId])
}

// Beschäftigungszeiträume eines Mitarbeiters
// Ein Mitarbeiter kann die Firma verlassen und später wieder eingestellt werden.
model EmploymentPeriod {
  id        String    @id @default(uuid())
  startDate DateTime
  endDate   DateTime?
  position  String?
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

// Dokumente eines Mitarbeiters, z. B. Aufenthaltstitel oder Arbeitsvertrag
model EmployeeDocument {
  id             String               @id @default(uuid())
  type           EmployeeDocumentType
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  fileUrl        String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([expiryDate])
}

enum CustomerType {
  COMPANY
  PRIVATE
}

model Customer {
  id          String       @id @default(uuid())
  customerNo  String       @unique
  type        CustomerType @default(COMPANY)
  companyName String?
  firstName   String?
  lastName    String?
  contactName String?
  email       String?
  phone       String?
  address     String?
  vatId       String?
  discount    Decimal      @default(0)
  isActive    Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  quotes   Quote[]
  invoices Invoice[]
}

enum EventStatus {
  INQUIRY
  QUOTED
  CONFIRMED
  PREPARING
  IN_PROGRESS
  COMPLETED
  INVOICED
  CLOSED
  CANCELLED
}

model Event {
  id          String      @id @default(uuid())
  eventNo     String      @unique
  name        String
  type        String?
  location    String?
  startDate   DateTime
  endDate     DateTime
  status      EventStatus @default(INQUIRY)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  reservations Reservation[]

  quotes   Quote[]
  invoices Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([startDate])
}

// Produktmodell im Gerätekatalog, z. B. Sony FX6
model Product {
  id          String  @id @default(uuid())
  productNo   String  @unique
  name        String
  brand       String?
  model       String?
  category    String?
  description String?

  // SERIALIZED = einzelne Geräte, QUANTITY = Mengenartikel
  trackingType ProductTrackingType @default(SERIALIZED)

  // RENTAL = Vermietung, SALE = Verkauf, BOTH = beides
  usageType ProductUsageType @default(RENTAL)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems InventoryItem[]
  quoteItems     QuoteItem[]
  invoiceItems   InvoiceItem[]
}

enum ProductTrackingType {
  SERIALIZED
  QUANTITY
}

enum ProductUsageType {
  RENTAL
  SALE
  BOTH
}

// Physisches Gerät oder einzelner Lagerartikel
model InventoryItem {
  id                 String              @id @default(uuid())
  assetNo            String              @unique
  manufacturerSerial String?             @unique
  barcode            String?             @unique
  status             InventoryItemStatus @default(AVAILABLE)
  location           String?
  purchaseDate       DateTime?
  purchasePrice      Decimal?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  reservations Reservation[]
  movements    EquipmentMovement[]

  @@index([productId])
  @@index([warehouseId])
  @@index([status])
}

enum InventoryItemStatus {
  RECEIVED
  AVAILABLE
  RESERVED
  PICKING
  PACKED
  IN_TRANSIT
  AT_EVENT
  RETURNING
  INSPECTION
  DAMAGED
  MAINTENANCE
  REPAIRED
  LOST
  RETIRED
}

// Status einer Geräte-Reservierung
enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// Reservierung eines konkreten Geräts für ein Event
model Reservation {
  id        String            @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  status    ReservationStatus @default(PENDING)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  inventoryItemId    String
  inventoryItem      InventoryItem       @relation(fields: [inventoryItemId], references: [id])
  equipmentMovements EquipmentMovement[]

  @@index([eventId])
  @@index([inventoryItemId])
  @@index([startDate, endDate])
  @@index([status])
}

// Gründe für eine Bestandsbewegung
enum EquipmentMovementType {
  RECEIVED
  RESERVED
  RELEASED
  PICKED
  PACKED
  LOADED
  TRANSFERRED
  DELIVERED_TO_EVENT
  RETURNED_FROM_EVENT
  INSPECTION
  MAINTENANCE
  REPAIRED
  LOST
  RETIRED
  MANUAL_ADJUSTMENT
}

// Speichert die vollständige Bewegungshistorie eines Geräts
model EquipmentMovement {
  id           String                @id @default(uuid())
  type         EquipmentMovementType
  fromStatus   InventoryItemStatus?
  toStatus     InventoryItemStatus
  fromLocation String?
  toLocation   String?
  notes        String?

  createdAt DateTime @default(now())

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  responsibleEmployeeId String?
  responsibleEmployee   Employee? @relation(fields: [responsibleEmployeeId], references: [id])

  @@index([reservationId])
  @@index([responsibleEmployeeId])
  @@index([inventoryItemId])
  @@index([createdAt])
  @@index([type])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum QuoteItemType {
  EQUIPMENT
  SERVICE
  TRANSPORT
  PERSONNEL
  OTHER
}

// Angebot für einen Kunden
model Quote {
  id         String      @id @default(uuid())
  quoteNo    String      @unique
  status     QuoteStatus @default(DRAFT)
  validUntil DateTime?
  notes      String?

  subtotal Decimal @default(0)
  discount Decimal @default(0)
  tax      Decimal @default(0)
  total    Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  items    QuoteItem[]
  invoices Invoice[]

  @@index([customerId])
  @@index([eventId])
  @@index([status])
}

// Einzelne Position innerhalb eines Angebots
model QuoteItem {
  id          String        @id @default(uuid())
  type        QuoteItemType
  description String
  quantity    Decimal       @default(1)
  unitPrice   Decimal
  discount    Decimal       @default(0)
  total       Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@index([productId])
}

// Status einer Rechnung
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

// Typ einer Rechnungsposition
enum InvoiceItemType {
  EQUIPMENT
  SERVICE
  TRANSPORT
  PERSONNEL
  OTHER
}

// Rechnung für einen Kunden
model Invoice {
  id        String        @id @default(uuid())
  invoiceNo String        @unique
  status    InvoiceStatus @default(DRAFT)

  issueDate DateTime?
  dueDate   DateTime?
  notes     String?

  subtotal Decimal @default(0)
  discount Decimal @default(0)
  tax      Decimal @default(0)
  total    Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  items InvoiceItem[]

  @@index([customerId])
  @@index([eventId])
  @@index([quoteId])
  @@index([status])
}

// Einzelne Position innerhalb einer Rechnung
model InvoiceItem {
  id          String          @id @default(uuid())
  type        InvoiceItemType
  description String
  quantity    Decimal         @default(1)
  unitPrice   Decimal
  discount    Decimal         @default(0)
  total       Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

// Rollen für die Zugriffssteuerung
enum UserRole {
  OWNER
  ADMIN
  HR_MANAGER
  ACCOUNTANT
  SALES_MANAGER
  PROJECT_MANAGER
  DEPARTMENT_MANAGER
  WAREHOUSE_MANAGER
  TECHNICIAN
  WAREHOUSE_EMPLOYEE
  SALES_EMPLOYEE
  EMPLOYEE
}

// Anwendungsbenutzer mit Clerk-Identität und interner Rolle
model AppUser {
  id          String   @id @default(uuid())
  clerkUserId String   @unique
  email       String?
  role        UserRole @default(EMPLOYEE)
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}
