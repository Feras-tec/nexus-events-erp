# PostgreSQL / Neon
DATABASE_URL=
DIRECT_URL=

# Clerk Authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# CORS
CORS_ORIGINS=http://127.0.0.1:5173

# Server
PORT=3210

# Lokal ohne Proxy: 0; auf Render erst nach Prüfung der Proxy-Kette passend setzen.
TRUST_PROXY_HOPS=0

# MongoDB (optional legacy audit source; not used for runtime ERP data)
MONGODB_URI=

# Business audit storage: postgresql (default and recommended)
BUSINESS_AUDIT_MODE=postgresql

# E-Mail-Versand (falls verwendet)
RESEND_API_KEY=
EMAIL_FROM=

# Primary authentication: auth-v2 (default); explicit temporary rollback: clerk
AUTH_MODE=auth-v2
# Required for Auth-V2; never reuse a production URL or signing secret locally.
AUTH_V2_DATABASE_URL=
AUTH_V2_AUTH_SECRET=
AUTH_V2_BASE_URL=http://127.0.0.1:3210
AUTH_V2_APP_URL=http://127.0.0.1:5173
AUTH_V2_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:3210
AUTH_V2_SECURE_COOKIES=false
AUTH_V2_EMAIL_DELIVERY_ENABLED=false
AUTH_V2_EXPOSE_INVITATION_TOKEN=false
